# ---------------------------------------------------------------------------
# Ingestion — the Firefox extension writes here, `import`/`watch` consume it
# ---------------------------------------------------------------------------

# Where the extension saves its export (desktop: "Save bundle to Downloads").
DROP_DIR=~/Downloads/ticket-parser

# Where `import` looks for documents (Word, PDF…) an export could not include
# because they were not downloaded in WhatsApp in that tab. Searched two
# levels deep; several folders separated by ":". The drop folder is skipped.
DOCUMENT_SEARCH_DIRS=~/Downloads

# How often `watch` checks the drop folder and, if enabled, the mailbox.
WATCH_INTERVAL_SECONDS=30

# A burst of messages becomes one PDF once the chat has been silent this long.
# 2h: a follow-up screenshot an hour later still joins the same report.
QUIET_PERIOD_SECONDS=7200


# ---------------------------------------------------------------------------
# Mail intake (optional) — the mobile route
#
# On the phone the extension shares a bundle to your mail app; `watch`/`mail`
# fetch it back. Leave MAIL_ENABLED=false if you only export on the desktop.
# ---------------------------------------------------------------------------

MAIL_ENABLED=false

# GMX has .com / .de / .net variants; use the one matching your account.
# IMAP must be enabled in GMX web settings before it accepts a connection.
IMAP_HOST=imap.gmx.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Only mail whose From matches one of these is read. Comma separated.
# Set this to the address you send the bundles FROM.
ALLOWED_SENDERS=

# Legacy: only used by the retired src/ticket_parser/ingest.py path.
POLL_INTERVAL_SECONDS=300


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

DATA_DIR=./data
OUT_DIR=./data/out

# done/ batches older than this are pruned by `ticket-parser prune`.
# out/ PDFs are never auto-pruned.
RETENTION_DAYS=30

# `status` exits non-zero above this many pending messages -- it means the
# pipeline has been failing, not that you have a lot of bugs.
BACKLOG_WARN_THRESHOLD=50

LOG_LEVEL=INFO
LOG_FILE=./data/ticket-parser.log


# ---------------------------------------------------------------------------
# LLM passes — all via the `claude` CLI, no API key
# ---------------------------------------------------------------------------

LLM_ENABLED=true

# Absolute path is safer for cron/systemd, whose PATH is not your shell's.
CLAUDE_BIN=claude

# Fallback model for both passes. Empty = whatever the CLI defaults to.
CLAUDE_MODEL=sonnet

# Per-pass overrides. Clustering reads the messages and returns a few lines of
# JSON. Investigation navigates an unfamiliar codebase and produces a judgement
# you will act on, so it is worth more model.
#
# The aliases "sonnet", "opus", "haiku" always mean the latest model of that
# family (resolved by the claude CLI; updating the CLI moves them forward, and
# cached verdicts are re-done then). Pin an exact id instead, e.g.
# claude-sonnet-5-5 or claude-opus-5-5, to keep results comparable over time.
CLAUDE_MODEL_CLUSTER=sonnet
CLAUDE_MODEL_INVESTIGATE=opus

# Seconds per invocation before the subprocess is killed.
CLAUDE_TIMEOUT_SECONDS=600

# How many repo investigations run at once.
CLAUDE_CONCURRENCY=2

# Repository each issue is confronted against. Read-only; never mutated.
REPO_PATH=/home/scorbutics/dev/peps_ta_boite


# ---------------------------------------------------------------------------
# Voice note transcription -- offline, free, via faster-whisper. No API key.
# Requires `pip install -e '.[transcribe]'`; otherwise voice notes are kept
# in the report with no transcript.
# ---------------------------------------------------------------------------

TRANSCRIBE_ENABLED=true

# tiny | base | small | medium | large-v3 -- bigger is slower and more accurate.
# "base" is a reasonable default for a short voice note on CPU.
WHISPER_MODEL=base

# cpu | cuda
WHISPER_DEVICE=cpu

# int8 is fastest on CPU; use float16 on a GPU.
WHISPER_COMPUTE_TYPE=int8
