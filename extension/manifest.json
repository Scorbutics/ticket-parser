{
  "manifest_version": 3,
  "name": "ticket-parser scraper",
  "version": "0.2.1",
  "description": "Read the open WhatsApp Web conversation and export it for ticket-parser. Reads only; never sends anything.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ticket-parser@scorbutics.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "Export this conversation",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "vendor/pdf.min.js",
      "export-format.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
